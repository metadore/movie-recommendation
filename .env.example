# CinePulse – Docker Compose environment
# Copy this file to .env and fill in real values before running docker compose up

# Shared SQLite path inside the db_data volume (default)
# DATABASE_URL=sqlite:////data/movies.db

# To use PostgreSQL instead (recommended for production):
# DATABASE_URL=postgresql://user:password@host:5432/cinepulse

JWT_SECRET=cinepulse-prod-secret-replace-me-with-64-random-chars

# Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=

# Get a free key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=
